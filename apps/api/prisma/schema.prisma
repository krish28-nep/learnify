generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  STUDENT
}

model User {
  id        String   @id @default(uuid())

  name      String
  email     String   @unique
  passwordHash  String

  role      UserRole @default(STUDENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id String @id @default(uuid())

  title        String
  slug         String  @unique
  code         String?
  description  String?
  creditHours  Int?
  sortingOrder Int     @default(0)

  units Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id String @id @default(uuid())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  title        String
  slug         String
  description  String?
  sortingOrder Int     @default(0)

  contents Content[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, title])
  @@index([subjectId])
}

model Content {
  id String @id @default(uuid())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  title       String
  description String?

  // PDF information
  fileUrl      String
  filePublicId String?
  fileName     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
}
