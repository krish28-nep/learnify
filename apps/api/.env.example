# Copy this file to `apps/api/.env` for local API development.
# Connection string for PostgreSQL.
# The host port matches POSTGRES_PORT in the repository root .env file.

DATABASE_URL="postgresql://app:app@localhost:5433/app?schema=public"
PORT=4000
WEB_URL=http://localhost:3000

# Admin account created by `pnpm --filter api prisma:seed`
ADMIN_NAME=Learnify Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
